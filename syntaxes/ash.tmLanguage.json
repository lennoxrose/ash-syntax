{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ash",
  "scopeName": "source.ash",
  "patterns": [
    { "include": "#comments" },
    { "include": "#imports" },
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [{ "name": "comment.line.double-slash.ash", "match": "//.*$" }]
    },
    "imports": {
      "patterns": [
        {
          "name": "meta.import.ash",
          "begin": "(@import)\\s*(<)",
          "beginCaptures": {
            "1": { "name": "keyword.control.import.ash" },
            "2": { "name": "punctuation.definition.string.begin.ash" }
          },
          "end": ">",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.ash" } },
          "patterns": [{ "name": "string.quoted.other.import-path.ash", "match": "[^>]+" }]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ash",
          "match": "\\b(given|otherwise|during|each|in|stop|next|attempt|handle|raise|yield|say)\\b"
        },
        { "name": "keyword.declaration.ash", "match": "\\b(local|forge)\\b" },
        { "name": "keyword.operator.word.ash", "match": "\\b(and|or|not)\\b" },
        { "name": "constant.language.boolean.ash", "match": "\\b(yes|no)\\b" },
        { "name": "constant.language.null.ash", "match": "\\bnone\\b" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.ash",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.ash", "match": "\\\\." }]
    },
    "numbers": {
      "name": "constant.numeric.ash",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    "functions": {
      "patterns": [
        {
          "comment": "function name in a 'forge' definition",
          "match": "(?<=\\bforge\\s+)[a-zA-Z_][a-zA-Z0-9_]*",
          "name": "entity.name.function.ash"
        },
        {
          "comment": "builtin function call",
          "match": "\\b(abs|append_file|array|delete|file_exists|filter|floor|has|input|join|keys|len|lower|map|num|push|read_file|reduce|replace|split|sqrt|str|substring|trim|type|upper|values|write_file)\\b(?=\\s*\\()",
          "name": "support.function.builtin.ash"
        },
        {
          "comment": "function call name",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?=\\s*\\()",
          "name": "entity.name.function.call.ash"
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.bitwise.shift.ash", "match": "<<|>>" },
        { "name": "keyword.operator.comparison.ash", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.compound.ash", "match": "\\+=|-=|\\*=|/=" },
        { "name": "keyword.operator.increment.ash", "match": "\\+\\+|--" },
        { "name": "keyword.operator.assignment.ash", "match": "=" },
        { "name": "keyword.operator.bitwise.ash", "match": "&|\\||\\^|~" },
        { "name": "keyword.operator.arithmetic.ash", "match": "\\+|\\-|\\*|/|%" },
        { "name": "keyword.operator.ternary.ash", "match": "\\?" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.ash", "match": ";" },
        { "name": "punctuation.separator.comma.ash", "match": "," },
        { "name": "punctuation.separator.key-value.ash", "match": ":" },
        { "name": "punctuation.accessor.ash", "match": "\\." },
        { "name": "punctuation.section.braces.ash", "match": "[{}]" },
        { "name": "punctuation.section.parens.ash", "match": "[()]" },
        { "name": "punctuation.section.brackets.ash", "match": "[\\[\\]]" }
      ]
    }
  }
}
